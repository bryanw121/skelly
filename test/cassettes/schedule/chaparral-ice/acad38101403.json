{"meta":{"page":{"current-page":4,"per-page":100,"from":301,"to":316,"total":316,"last-page":4}},"links":{"first":"http://apps.daysmartrecreation.com/api/v1/events?filter%5Bstart__gte%5D=2026-11-23&filter%5Bstart__lte%5D=2026-12-07T23%3A59%3A59&sort=start&page%5Bnumber%5D=1&page%5Bsize%5D=100","prev":"http://apps.daysmartrecreation.com/api/v1/events?filter%5Bstart__gte%5D=2026-11-23&filter%5Bstart__lte%5D=2026-12-07T23%3A59%3A59&sort=start&page%5Bnumber%5D=3&page%5Bsize%5D=100","last":"http://apps.daysmartrecreation.com/api/v1/events?filter%5Bstart__gte%5D=2026-11-23&filter%5Bstart__lte%5D=2026-12-07T23%3A59%3A59&sort=start&page%5Bnumber%5D=4&page%5Bsize%5D=100"},"data":[{"type":"events","id":"348525","attributes":{"repeat_id":348525,"resource_id":1,"resource_area_id":0,"desc":"Freestyle Session 12/07/26 1:45pm","event_type_id":"14","sub_type":"regular","start":"2026-12-07T13:45:00","start_gmt":"2026-12-07T19:45:00","end":"2026-12-07T14:15:00","end_gmt":"2026-12-07T20:15:00","hteam_id":42993,"vteam_id":null,"league_id":3067,"home_score":null,"visiting_score":null,"publish":true,"outcome":"","register_capacity":25,"create_u":"psgrant","created_user_type":"SIT_Employee","create_d":"2026-10-13T15:15:33","mod_u":"psgrant","last_modified_user_type":"SIT_Employee","mod_d":"2026-10-13T17:38:37","is_overtime":false,"booking_id":null,"description":null,"notice":null,"last_resource_id":null,"parent_event_id":null,"has_gender_locker_rooms":0,"locker_room_type":null,"includes_setup_time":false,"includes_takedown_time":false,"start_date":"2026-12-07T00:00:00","event_start_time":"13:45:00","best_description":"<p><b>Freestyle sessions are offered almost daily. Freestyle sessions are not for the general public, please see public skate hours.</b></p>\n<ul>\n<li><b>Regular Freestyle Sessions </b>are designed for Figure skaters who have passed all basic skill levels and are in Free Skate 1 and up practicing jumps, spins, and other high-level skills. (Not for general Public Skating)</li>\n</ul>\n<p><br /><b>Please follow PSA recommended Freestyle etiquette guidelines:</b></p>\n<ul>\n<li>Skaters running programs have first right of way; must wear visibility belt on to signify right of way while skating a program. May not run programs more than twice while in a lesson</li>\n<li>Skaters in class or private lessons have second right of way; Coaches should remain in hockey benches or by their students at all times and not plant themselves in the direct path of travel of skaters. Do not chase your skaters and share the ice</li>\n<li>Spins should be worked on in the center of the ice</li>\n<li>Jumps should be performed on the ends of the ice</li>\n<li>Do not stand against the wall to the point it blocks the flow of traffic, skaters should not be working on jumps or spins near the wall if it interferes with the flow of traffic</li>\n<li>If a break or converstaion is needed for a period of time please exit the ice and return when you are ready to continue skating</li>\n<li>Please be aware of your surrounding and always look before leaving an area</li>\n</ul>\n<p><b>Cancellation Policy</b></p>\n<ul>\n<li>All cancellation or transfer requests must be in writing and must be emailed to<strong> redacted@example.com</strong>. Verbal requests will be denied and redirected to our \"in-writing&rdquo; clause.</li>\n<li>Any requests made prior to 72 hours of the start of the session will be refunded fully.</li>\n<li>All monetary refund requests that are made 24-72 hours in advance of the start of the session will be subject to an administrative fee of 25%.</li>\n<li>Any requests made less than 24 hours in advance of the start of the session will be subject to forfeiture of payment.</li>\n</ul>"},"relationships":{"eventType":{"data":null},"subType":{"data":null},"homeTeam":{"data":null},"visitingTeam":{"data":null},"summary":{"data":null},"league":{"data":null},"booking":{"data":null},"parentEvent":{"data":null},"lockers":{"data":null},"lastResource":{"data":null},"resource":{"data":null},"resourceArea":{"data":null},"tasks":{"data":null},"teamGroups":{"data":null},"eventSeries":{"data":null},"statEvents":{"data":null},"fees":{"data":null},"invoices":{"data":null},"seriesInvoices":{"data":null},"invoiceItems":{"data":null},"employees":{"data":null},"eventEmployees":{"data":null},"additionalResources":{"data":null},"setupEvents":{"data":null},"takedownEvents":{"data":null},"comments":{"data":null},"rsvpStates":{"data":null}},"links":{"self":"http://apps.daysmartrecreation.com/api/v1/events/348525"},"meta":null},{"type":"events","id":"348526","attributes":{"repeat_id":348526,"resource_id":1,"resource_area_id":0,"desc":"Freestyle Session 12/07/26 2:15pm","event_type_id":"14","sub_type":"regular","start":"2026-12-07T14:15:00","start_gmt":"2026-12-07T20:15:00","end":"2026-12-07T14:45:00","end_gmt":"2026-12-07T20:45:00","hteam_id":42995,"vteam_id":null,"league_id":3067,"home_score":null,"visiting_score":null,"publish":true,"outcome":"","register_capacity":25,"create_u":"psgrant","created_user_type":"SIT_Employee","create_d":"2026-10-13T15:15:33","mod_u":"psgrant","last_modified_user_type":"SIT_Employee","mod_d":"2026-10-13T17:38:43","is_overtime":false,"booking_id":null,"description":null,"notice":null,"last_resource_id":null,"parent_event_id":null,"has_gender_locker_rooms":0,"locker_room_type":null,"includes_setup_time":false,"includes_takedown_time":false,"start_date":"2026-12-07T00:00:00","event_start_time":"14:15:00","best_description":"<p><b>Freestyle sessions are offered almost daily. Freestyle sessions are not for the general public, please see public skate hours.</b></p>\n<ul>\n<li><b>Regular Freestyle Sessions:</b> Designed for Figure skaters in Free Skate 1 and up. (Not for general Public Skating)</li>\n<li><b>Open Freestyle Sessions:</b> Designed for Skaters of all levels that have skating experience and are working on developing skills. (Not for general public skating).</li>\n<li><b>Low Freestyle Sessions:</b> Designed for Figure skaters who have not passed any USFS or ISI freestyle skating tests. (Not for general Public Skating)</li>\n<li><b>High Freestyle Sessions:</b> Designed for Figure skaters who have passed Pre-Preliminary Free Skate and Preliminary Moves, ISI equivalent Freestyle 4/5, Pre-Bronze Dance, or Adult Bronze Free Skate tests. (Not for general Public Skating)</li>\n<li><b>Development Session:</b> Open to all types of skaters in private lessons, no props or pucks allowed on the ice. Must have a private lesson scheduled. Rentals not allowed. (Not for general Public Skating)</li>\n<li><b>Adult Freestyle Session:</b> Adults 18 and up. Must be Adult 3 and up. No rental skates on session. Ice will be shared with Ice Dancing class. (Not for general Public Skating)</li>\n<li><b>Ice Dance/MITF Freestyles Sessions:</b> Designed for Figure Skaters working on Ice Dance and Moves in the Field Patterns. Freestyle elements are not allowed on this session (i.e., jumps and spins)(Not for general Public Skating)</li>\n</ul>\n<p><br /><b>Please follow PSA recommended Freestyle etiquette guidelines:</b></p>\n<ul>\n<li>Skaters running programs have first right of way; must wear visibility belt on to signify right of way while skating a program. May not run programs more than twice while in a lesson</li>\n<li>Skaters in class or private lessons have second right of way; Coaches should remain in hockey benches or by their students at all times and not plant themselves in the direct path of travel of skaters. Do not chase your skaters and share the ice</li>\n<li>Spins should be worked on in the center of the ice</li>\n<li>Jumps should be performed on the ends of the ice</li>\n<li>Do not stand against the wall to the point it blocks the flow of traffic, skaters should not be working on jumps or spins near the wall if it interferes with the flow of traffic</li>\n<li>If a break or converstaion is needed for a period of time please exit the ice and return when you are ready to continue skating</li>\n<li>Please be aware of your surrounding and always look before leaving an area</li>\n</ul>\n<p><b>Cancellation Policy</b></p>\n<ul>\n<li>All cancellation or transfer requests must be in writing and must be emailed to<strong> redacted@example.com</strong>. Verbal requests will be denied and redirected to our \"in-writing&rdquo; clause.</li>\n<li>Any requests made prior to 72 hours of the start of the session will be refunded fully.</li>\n<li>All monetary refund requests that are made 24-72 hours in advance of the start of the session will be subject to an administrative fee of 25%.</li>\n<li>Any requests made less than 24 hours in advance of the start of the session will be subject to forfeiture of payment.</li>\n</ul>"},"relationships":{"eventType":{"data":null},"subType":{"data":null},"homeTeam":{"data":null},"visitingTeam":{"data":null},"summary":{"data":null},"league":{"data":null},"booking":{"data":null},"parentEvent":{"data":null},"lockers":{"data":null},"lastResource":{"data":null},"resource":{"data":null},"resourceArea":{"data":null},"tasks":{"data":null},"teamGroups":{"data":null},"eventSeries":{"data":null},"statEvents":{"data":null},"fees":{"data":null},"invoices":{"data":null},"seriesInvoices":{"data":null},"invoiceItems":{"data":null},"employees":{"data":null},"eventEmployees":{"data":null},"additionalResources":{"data":null},"setupEvents":{"data":null},"takedownEvents":{"data":null},"comments":{"data":null},"rsvpStates":{"data":null}},"links":{"self":"http://apps.daysmartrecreation.com/api/v1/events/348526"},"meta":null},{"type":"events","id":"348224","attributes":{"repeat_id":348224,"resource_id":1,"resource_area_id":0,"desc":"Public Skate 12/07/26 2:45pm-5:00pm","event_type_id":"6","sub_type":"regular","start":"2026-12-07T14:45:00","start_gmt":"2026-12-07T20:45:00","end":"2026-12-07T17:00:00","end_gmt":"2026-12-07T23:00:00","hteam_id":42899,"vteam_id":null,"league_id":3065,"home_score":null,"visiting_score":null,"publish":true,"outcome":"","register_capacity":200,"create_u":"psgrant","created_user_type":"SIT_Employee","create_d":"2026-10-12T10:43:25","mod_u":"psgrant","last_modified_user_type":"SIT_Employee","mod_d":"2026-10-12T10:54:00","is_overtime":false,"booking_id":null,"description":null,"notice":null,"last_resource_id":null,"parent_event_id":null,"has_gender_locker_rooms":0,"locker_room_type":null,"includes_setup_time":false,"includes_takedown_time":false,"start_date":"2026-12-07T00:00:00","event_start_time":"14:45:00","best_description":"<p><strong><i>All skaters need to be registered to skate on any session. Spectators are allowed inside the building per COVID guidelines located on our website. We <u>highly recommend</u> pre-registering for any sessions a skater wants to attend in order to provide a faster check-in process. You may register as a walk-in, however a skater must have an account and signed waiver in the registration system. If an account has not been created a skater may create their account and sign the waiver using one of our front desk kiosks.</i>&nbsp;<br /><u><br /></u>Public Skating Session Rules</strong></p>\n<p><strong>During all public skating sessions, the following rules must be followed for the safety of all skaters.</strong></p>\n<ul>\n<li>Absolutely no spirals, camel spins, or any move where the skater&rsquo;s blade is elevated above the hip are allowed on public skating sessions at any time, regardless of number of skaters on the ice.</li>\n<li>Jumps and spins may only be performed within the coned off area in the center of the ice.</li>\n<li>Skating must follow the general flow of traffic.</li>\n<li>General public skaters always have the right of way on public skating sessions.</li>\n<li>No props or objects may be left unattended on the ice at any time.</li>\n<li>No throwing snow or other objects while on the ice</li>\n<li>No sticks or pucks are allowed at any time.</li>\n<li>Do not carry children or other skaters on the ice at any time.</li>\n<li>Programs may not be run on public sessions at any time. Not even with a mobile speaker.</li>\n</ul>\n<p><strong>Employees on duty have the right to restrict <u>ALL</u> activities as they see fit.</strong></p>\n<p><strong>Consequences:</strong></p>\n<p>Any failure to follow the previously listed rules may result in:</p>\n<ul>\n<li>Removal of skater(s) from the ice.</li>\n<li>Suspension from skating activities for a period of time.</li>\n<li>Loss of skating privileges.</li>\n<li>No refunds will be given to anyone who is removed from the ice.</li>\n<li>No transfers of your current session to a different session is allowed or public admissions.</li>\n<li>Repeat offenses may result in permanent suspension of skating privileges.</li>\n</ul>\n<p>All information subject to change without notice.</p>\n<p><b>Cancellation Policy</b></p>\n<ul>\n<li>All cancellation or transfer requests must be in writing and must be emailed to <b>info</b><strong>@chaparralice.com or redacted@example.com</strong>. Verbal requests will be denied and redirected to our \"in-writing&rdquo; clause.</li>\n<li>Any requests made prior to 72 hours will be refunded fully.</li>\n<li>All monetary refund requests that are made 24-72 hours in advance will be subject to an administrative fee of 25%</li>\n<li>Any requests made less than 24 hours in advance will be subject to forfeiture of payment.</li>\n</ul>"},"relationships":{"eventType":{"data":null},"subType":{"data":null},"homeTeam":{"data":null},"visitingTeam":{"data":null},"summary":{"data":null},"league":{"data":null},"booking":{"data":null},"parentEvent":{"data":null},"lockers":{"data":null},"lastResource":{"data":null},"resource":{"data":null},"resourceArea":{"data":null},"tasks":{"data":null},"teamGroups":{"data":null},"eventSeries":{"data":null},"statEvents":{"data":null},"fees":{"data":null},"invoices":{"data":null},"seriesInvoices":{"data":null},"invoiceItems":{"data":null},"employees":{"data":null},"eventEmployees":{"data":null},"additionalResources":{"data":null},"